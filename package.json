{
  "name": "estetica-e-bem-estar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-estetica",
    "test:rules": "firebase emulators:exec --only firestore --project demo-estetica \"node --test tests/firestore.rules.test.mjs\"",
    "test:firebase": "firebase emulators:exec --only auth,firestore --project demo-estetica \"node scripts/firebase-e2e.mjs\"",
    "test:auth": "firebase emulators:exec --only auth --project demo-estetica \"node scripts/firebase-e2e.mjs --grep @auth\"",
    "build:firebase": "node scripts/build-firebase.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "firebase-tools": "^15.35.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
